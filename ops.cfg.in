# 873 - zipper.jpl.nasa.gov - Operations
# **************************************
#
# This is the application server configuration for the host zipper.jpl.nasa.gov
# providing services for the Center for Data Science and Technology.
#
# To use this buildout:
# First, copy ops.cfg.in to ops.cfg and edit that, seeting passwords
# Then, bootstrap: python2.7 bootstrap.py -dc operations.cfg
# Then, buildout: bin/buildout -c ops.cfg
# Then, start it all up: bin/supervisord
#
# Copyright 2011–2018 California Institute of Technology. ALL RIGHTS RESERVED.
# U.S. Government sponsorship acknowledged. You're looking good today.

# Configurable Items
# ==================
#
# In the following sections (hosts, ports, users, passwords), you may wish to
# override default settings. In fact, you'll definitely want to change the
# passwords, because the default values below are stupid.


# Passwords
# ---------
#
# Account user names and passwords to access administrative interfaces.
[zope]
username = zope-admin
password = secret

[supervisor]
username = supervisor-admin
password = secret


# In operations, the debug Zope instance is a ZEO client.
[zope-debug]
zeo-client = true


# Buildout Infrastructure
# =======================
#
# Nothing needs changing here.
[buildout]
update-versions-file = var/current-ops-versions.cfg
extends =
    etc/base.cfg
    etc/versions/known-good-versions.cfg
parts =
    lxml
    python
    backup
    zeo
    supervisor
    zope
    zope-debug
    zope-backup
    zope-pack
    zope-snapshot
    site-start
eggs-directory = /usr/local/cdst-site/buildout/eggs
download-cache = /usr/local/cdst-site/buildout/downloads
extends-cache  = /usr/local/cdst-site/buildout/extends

